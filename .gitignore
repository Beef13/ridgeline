node_modules/
dist/
*.local
.DS_Store
Thumbs.db

# Test screenshots get dropped in the project root, so *.png is ignored — but
# anything under public/ is a real asset the site cannot render without. The
# logo was invisible on the published build for exactly this reason: it lived
# in public/ but outside public/art/, so the one exception missed it.
*.png
!public/**/*.png
!public/*.png
# Logo and art working files moved out of public/ so they stop being served to
# players. They are still the source of the marks, so the *.png rule above must
# not swallow them on the way out.
!design-source/**/*.png
!design-source/**/*.ai

# Scratch that keeps turning up in `git status`. None of it belongs to the
# build: "Claude outputs" is where delivered zips land, _to_delete holds files
# waiting to be removed by hand, and the .tmp files are half-written art
# exports. test.mov is a reference recording, not a game asset — anything left
# in public/audio is published and shipped to every player.
Claude outputs/
_to_delete/
*.tmp
public/audio/*.mov

# The About editor writes a snapshot before each save, for its Undo button.
about.content.bak.json

# Editor working files. These keep landing in public/art because that is where
# the exports go, and anything under public/ is published — a .psd or .ai there
# is several MB downloaded by every player for no reason. Ignored outright so a
# stray save cannot ship; the real ones live in design-source/logos/.
public/**/*.psd
public/**/*.ai
